# ============================================================================================
# PequesSaaS — variables de entorno. Copia a .env.local (desarrollo) o configúralas en Vercel
# (Settings → Environment Variables, una por entorno: Development / Preview / Production).
# NUNCA subas valores reales al repositorio. Verifica con: npm run env:check
# Guía completa: docs/DESPLIEGUE_VERCEL.md
# ============================================================================================

# --- Base de datos (Turso / libSQL) ------------------------------------------------------
# Bases y tokens DISTINTOS para desarrollo y producción. Desarrollo local opcional: file:./prisma/local.db (sin token)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Aplicación (obligatorias) ------------------------------------------------------------
# Firma las sesiones y deriva la clave que cifra credenciales por establecimiento (WhatsApp, PSE de SUNAT). Mínimo 32 caracteres aleatorios.
# Si se rota, hay que volver a guardar esas credenciales de cada establecimiento y se cierran todas las sesiones.
AUTH_SECRET=
# URL pública https del sistema (webhooks, enlaces, retorno de pagos). En producción: https://tu-dominio
APP_URL=
# Protege los endpoints de Vercel Cron (/api/cron/*) y el detalle de /api/health. Mínimo 16 caracteres aleatorios.
CRON_SECRET=

# --- Chatbot de IA (clave global del sistema; el consumo se limita por plan) ---------------
ANTHROPIC_API_KEY=
# Opcionales: modelo (por defecto claude-opus-5-5) y esfuerzo (low|medium|high|xhigh|max; por defecto low)
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# --- Meta / WhatsApp Cloud API (ver docs/WHATSAPP_META_SETUP.md) ---------------------------
# App compartida: cada establecimiento puede guardar el suyo en /settings/whatsapp
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Versión de Graph API (formato vNN.N; por defecto v27.0)
META_API_VERSION=
# Solo pruebas/sandbox: URL base de Graph API (por defecto https://graph.facebook.com; en producción debe ser https)
META_GRAPH_BASE_URL=

# --- Cobro de suscripciones del SaaS (pasarela de la PLATAFORMA) ---------------------------
# NONE (solo pagos manuales Yape/Plin/transferencia confirmados por el SuperAdmin) | MOCK (sandbox, NO en producción) | MERCADOPAGO
PAYMENT_PROVIDER=NONE
# Obligatorias con PAYMENT_PROVIDER=MERCADOPAGO. El webhook a configurar en Mercado Pago es: {APP_URL}/api/webhooks/payments/mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Texto que ven los propietarios para pagar manualmente (p. ej. "Yape/Plin al 999 999 999 a nombre de ..., luego reporta tu pago aquí")
BILLING_MANUAL_INSTRUCTIONS=
